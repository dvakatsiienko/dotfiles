{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "extends": ["biome-config-polished"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/public/**/*",

      // Not ours to format — editor/app config consumed verbatim, and themes
      // whose diffs would be pure noise.
      "!**/import",
      "!home/.claude/themes",
      "!home/.claude/settings.json",
      "!home/.claude/keybindings.json",
      "!home/.claude/plugin-x/.claude-plugin",

      // Sub-package with its own tsconfig — linted on its own terms, not the
      // root config's. Carries a known noNonNullAssertion at src/index.ts:81.
      "!home/.claude/mcp-handoff-desktop"
    ]
  },

  // CLI scripts print for a living — the shared rule against console would have
  // biome's unsafe autofix delete their output. It did, once.
  "overrides": [
    {
      "includes": ["script/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ],

  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
