{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "extends": ["biome-config-polished"],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/public/**/*",

      // Not ours to format — editor/app config consumed verbatim, and themes
      // whose diffs would be pure noise.
      "!**/import",
      "!home/.claude/themes",
      "!home/.claude/settings.json",
      "!home/.claude/keybindings.json",
      "!home/.claude/plugin-x/.claude-plugin",
      "!cclio/plugin-cclio/.claude-plugin",

      // Upstream's, not ours: lazy-lock.json is rewritten by lazy.nvim on every
      // sync, so formatting it just starts a fight. The lua there has its own
      // stylua.toml.
      "!home/.config/nvim"
    ]
  },

  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
