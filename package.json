{
    "name": "dotfiles",
    "version": "0.0.1",
    "author": "Dima Vakatsiienko <imagnum.satellite@gmail.com>",
    "type": "module",
    "scripts": {
        "dotfiles:link": "node ./script/dotfiles-link.ts",
        "github:agent-token": "node ./script/github-agent-token.ts",
        "hotkey-monitor:build": "mkdir -p ./script/x-hotkey-stats-monitor/bin && swiftc -O ./script/x-hotkey-stats-monitor/main.swift -o ./script/x-hotkey-stats-monitor/bin/x-hotkey-stats-monitor && codesign --force --sign - --identifier com.dima.x-hotkey-stats-monitor ./script/x-hotkey-stats-monitor/bin/x-hotkey-stats-monitor",
        "hotkey-monitor:top": "node ./script/x-hotkey-stats-monitor/top.ts",
        "hotkeys:scan": "node ./script/hotkeys-scan.ts",
        "linear:agent-token": "node ./script/linear-agent-token.ts",
        "linear:push": "node ./script/linear-push.ts",
        "macos:setup": "node ./script/macos-setup.ts",
        "mcp:build": "pnpm --filter mcp-x-cw build",
        "plugin:release": "node ./script/plugin-release.ts",
        "skill:cclio-mode-snapshot": "node ./script/skill-cclio-mode-snapshot.ts",
        "skill:handoff-store": "node ./script/skill-handoff-store.ts",
        "skill:memory-sync-mirror": "node ./script/skill-memory-sync-mirror.ts",
        "sline:build": "cd ./home/.claude/sline && go build -trimpath -buildvcs=false -ldflags \"-s -w\" -o bin .",
        "sline:test": "cd ./home/.claude/sline && go test ./...",
        "typecheck": "tsc --noEmit && pnpm -r typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "biome check --write"
    },
    "dependencies": {
        "zx": "8.8.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@types/node": "26.2.0",
        "@types/react": "19.3.0",
        "biome-config-polished": "0.0.8",
        "lefthook": "2.1.14",
        "typescript": "7.0.2",
        "vitest": "5.0.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.0.0",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.3.4"
}
