[user]
    name = Dima Vakatsiienko
    email = imagnum.satellite@gmail.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILnChnk8JuZUBynotPPornPGEoRPZcOtK9srvd5QP91M

[core]
    editor        = vim
    autocrlf      = input
	pager = less -FRX
	# Every hook, every repo, one dispatcher — see that directory's `dispatch`.
	# This REPLACES git's hook lookup rather than adding to it, which is why the
	# dispatcher hands over to whatever the repo installed for itself.
	hooksPath = ~/.config/git/hooks

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true
	status = false
	verbose = false

[push]
    autoSetupRemote = true

[alias]
	# Pretty-print git log in graph mode
    lg = "log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --exclude=refs/conductor-checkpoints/* --all"
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	defaultBranch = main
[coderabbit]
	machineId = cli/95824464dd714d25a8c79a117fe70a14
[url "git@github.com:"]
	insteadOf = https://github.com/
