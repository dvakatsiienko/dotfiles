{
  "skillListingBudgetFraction": 0.025,
  "env": {
    "EDITOR": "nvim",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "NotebookEdit",
      "CronCreate",
      "CronDelete",
      "CronList",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/dima"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/guide-trigger-write.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/sline-focus.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/opus-register.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-host-reply.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-init.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-reply.sh SubagentStop"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/notification-spawn-reply.sh TaskCompleted"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/shelf/hooks/opus-register-capture.sh"
          }
        ]
      }
    ]
  },
  "disableAgentView": false,
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "/Users/dima/.claude/sline/bin",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "mattpocock-skills@claude-plugins-official": true,
    "x@x": true,
    "ralph-loop@claude-plugins-official": true,
    "linear-cli@linear-cli": false
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      },
      "autoUpdate": true
    },
    "x": {
      "source": {
        "source": "directory",
        "path": "/Users/dima/dotfiles/home/.claude/plugin-x"
      },
      "autoUpdate": true
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli"
      }
    }
  },
  "outputStyle": "output-fun",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-fable-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "low"
    }
  },
  "fastModePerSessionOptIn": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:gruvbox-ansi",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true,
  "leftArrowOpensAgents": false
}
