<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  x-screenshots-autoclean — every day at 12:00 moves screenshots older than 30 days from
  ~/Desktop/screenshots to ~/.Trash, recoverable until the trash is emptied.
  Hidden files, .DS_Store included, are left alone. A slot slept through runs at the next
  wake: launchd coalesces missed intervals, unlike cron.

  WHY A BINARY OF OUR OWN: TCC gates ~/Desktop per executable, and a system binary cannot be
  granted — /usr/bin/find under launchd answered "Operation not permitted" and did nothing.
  The binary below is ad-hoc signed with a stable identifier, so the one grant dima gives it
  survives every rebuild.

  Needs Files and Folders → Desktop (or Full Disk Access), granted once to the binary named
  below, in System Settings → Privacy & Security.

  Source: ~/dotfiles/script/x-screenshots-autoclean/main.swift · build: pnpm autoclean:build
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dima.x-screenshots-autoclean</string>

    <key>ProgramArguments</key>
    <array>
        <!-- launchd does not expand ~, so this path is absolute by necessity.
             Build it first: pnpm autoclean:build -->
        <string>/Users/dima/dotfiles/script/x-screenshots-autoclean/bin/x-screenshots-autoclean</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/dima/.local/share/x-screenshots-autoclean/run.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dima/.local/share/x-screenshots-autoclean/run.err.log</string>
</dict>
</plist>
