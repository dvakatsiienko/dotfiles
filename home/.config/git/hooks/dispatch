#!/bin/sh
#
# ? The global git hook directory, reached through `core.hooksPath` in
# ? ~/.gitconfig. Every hook name beside this file is a symlink to it; the
# ? script learns which hook it is from its own name, does our work, then hands
# ? over to whatever the repo itself installed and returns that exit code
# ? untouched.
# ?
# ? `core.hooksPath` REPLACES git's hook lookup rather than adding to it, so a
# ? name missing from this directory is a repo hook that silently stops running.
# ? Ten names are carried, and that is the whole set a client repo here uses:
# ? pre-commit · prepare-commit-msg · commit-msg · post-commit · pre-merge-commit
# ? pre-rebase · post-checkout · post-merge · post-rewrite · pre-push
# ?
# ? What the cut costs, stated rather than inferred: a repo installing a hook
# ? under any other name stops having it run. That is priced against what the
# ? other names actually are — the server-side set (`pre-receive`, `update`,
# ? `post-receive`, `post-update`, `proc-receive`, `push-to-checkout`) never
# ? fires on a client, `p4-*` needs git-p4, `sendemail-validate` needs
# ? git-send-email, and `applypatch-*` needs an emailed-patch workflow. Two were
# ? dropped for cost rather than for never firing: `reference-transaction` ran
# ? SEVEN times on a single commit and `post-index-change` fires on every index
# ? write, which is a shell process per event on a hot path. `fsmonitor-watchman`
# ? was never eligible — git reaches it by explicit path through `core.fsmonitor`
# ? and never through a hooks directory.
# ?
# ? Adding a name back is one symlink: `ln -s dispatch <hook-name>`.
# ?
# ? 🚨 Never run `lefthook install --force` or `--reset-hooks-path` while
# ? core.hooksPath points here: --force means "install into the current hooks
# ? path", and it replaces these symlinks with lefthook shims. It has happened.
# ? The repair is `ln -sf dispatch <name>` for each one it ate.
# ?
# ? Nothing in here may fail a git operation that would otherwise have
# ? succeeded. Our own work is best-effort; only the delegate decides the exit.

set -u

[ "${LEFTHOOK:-}" = "0" ] && exit 0

name=${0##*/}
self=$(realpath "$0" 2>/dev/null) || self=$0
root=${self%/home/.config/git/hooks/*}

# NOT `git rev-parse --git-path hooks`: that command honours core.hooksPath and
# answers with THIS directory, so every hook would exec itself forever. The
# common dir is immune to the setting, and is also the right answer inside a
# worktree, where .git is a file rather than a directory.
gitDir=${GIT_COMMON_DIR:-${GIT_DIR:-}}
if [ -z "$gitDir" ]; then
    gitDir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
fi

# 🚨 Self-defence, and it is not optional. `lefthook run` syncs its shims into
# core.hooksPath — THIS directory — and overwrites the symlink it was reached
# through; measured, it ate `pre-commit` on the first run. Pointing the setting
# back at the repo's own hooks dir for everything downstream sends that sync
# where it always used to go, whatever the repo's own config says.
index=${GIT_CONFIG_COUNT:-0}
eval "export GIT_CONFIG_KEY_$index=core.hooksPath"
eval "export GIT_CONFIG_VALUE_$index=\"\$gitDir/hooks\""
export GIT_CONFIG_COUNT=$((index + 1))

# Does this lefthook config declare the hook we are standing in for? Calling
# lefthook for a hook it does not define costs a banner and a "custom hooks path"
# warning box for nothing, and git fires some of these many times per command —
# `reference-transaction` printed seven boxes on one commit.
#
# Deliberately permissive. A key it fails to see is a repo gate silently lost,
# while a key it sees too eagerly is only the noise this exists to trim, so an
# indirect config keeps the call rather than guessing where its hooks live.
declares() {
    grep -qE "^[[:space:]]*(extends|remotes?|remote):" "$1" && return 0
    # yaml `pre-commit:` · json `"pre-commit":` · toml `[pre-commit]`. The `-` in
    # the leading class is what stops `prepare-commit-msg` answering for
    # `commit-msg`.
    grep -qE "(^|[^a-z-])${name}[\"']?[[:space:]]*[:=]" "$1" && return 0
    grep -qE "^[[:space:]]*\[[\"']?${name}[\"']?\]" "$1"
}

linearPush() {
    [ -f "$root/script/linear-push.ts" ] || return 0
    node=$(command -v node 2>/dev/null) ||
        node=$HOME/.local/share/fnm/aliases/default/bin/node
    [ -x "$node" ] || return 0
    "$node" "$root/script/linear-push.ts" hook "$@"
}

if [ "$name" = pre-push ]; then
    # git feeds the ref lines exactly once. We consume them, so they are kept on
    # disk and replayed to the delegate — a lefthook pre-push handed an empty
    # stream still exits 0, which makes a lost stream look exactly like success.
    refs=$(mktemp 2>/dev/null) || refs=
    if [ -n "$refs" ]; then
        trap 'rm -f "$refs"' EXIT
        cat > "$refs"
        linearPush "$@" < "$refs" || true
        exec 0< "$refs"
    fi
fi

delegate=$gitDir/hooks/$name
# A repo whose own hook is a link back here would loop until the process table
# gives out, and it would take every hook name with it.
[ -x "$delegate" ] && [ "$(realpath "$delegate" 2>/dev/null)" = "$self" ] && delegate=

# A lefthook shim is skipped rather than run: it calls `lefthook run` without
# --no-auto-install, which answers a set core.hooksPath with a five-line "Custom
# hooks paths are not supported" box on every commit. `call_lefthook` is the
# function every generated shim defines. Going straight to lefthook below runs
# the same jobs, quietly, and through one code path.
if [ -n "$delegate" ] && [ -x "$delegate" ] &&
    ! grep -q call_lefthook "$delegate" 2>/dev/null; then
    exec "$delegate" "$@"
fi

# No installed hook. `lefthook install` REFUSES to write while core.hooksPath is
# set — it exits 1 and touches nothing — so a lefthook repo has no shim to
# delegate to and is served directly instead. `lefthook run` on a hook the
# config does not define exits 0.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
for config in lefthook.yml lefthook.yaml lefthook.toml lefthook.json \
    .lefthook.yml .lefthook.yaml .config/lefthook.yml; do
    [ -f "$top/$config" ] || continue
    declares "$top/$config" || break

    # --no-auto-install is not optional: `lefthook run` otherwise syncs its shims
    # into core.hooksPath, which is THIS directory, and overwrites the symlink it
    # was just reached through. Measured — it ate `pre-commit` on the first run.
    if [ -n "${LEFTHOOK_BIN:-}" ]; then
        exec "$LEFTHOOK_BIN" run --no-auto-install "$name"
    elif command -v lefthook >/dev/null 2>&1; then
        exec lefthook run --no-auto-install "$name"
    elif [ -x "$top/node_modules/lefthook/bin/index.js" ]; then
        exec "$top/node_modules/lefthook/bin/index.js" run --no-auto-install "$name"
    fi
    break
done

exit 0
