{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": ["vite/client"],
        "verbatimModuleSyntax": true
    },
    // the scene modules one level up are shared with the node generators; the stage type-checks
    // them in a browser context too, which is what proves they stay free of node apis
    "include": ["src", "vite.config.ts", "../palette.ts", "../paper.ts", "../flora.ts", "../props.ts", "../lettering.ts", "../dino.ts", "../rex.ts", "../character.ts", "../valley.ts"]
}
