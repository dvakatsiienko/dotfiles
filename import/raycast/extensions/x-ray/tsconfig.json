{
    "$schema": "https://json.schemastore.org/tsconfig",
    "include": ["src/**/*", "raycast-env.d.ts"],
    "compilerOptions": {
        "lib": ["ES2023"],
        "types": ["node"],
        "module": "commonjs",
        "target": "ES2022",
        "jsx": "react-jsx",

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
