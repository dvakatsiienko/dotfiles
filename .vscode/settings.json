{
    "peacock.affectActivityBar": true,
    "peacock.affectStatusBar": true,
    "peacock.affectTitleBar": true,
    "peacock.color": "#ffc94d",
    "peacock.elementAdjustments": {
        "activityBar": "darken",
        "statusBar": "darken",
        "titleBar": "none"
    },
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#ffba1a",
