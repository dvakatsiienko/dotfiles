{
  "env": {
    "EDITOR": "nvim"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Edit(//Users/dima/.claude/**)",
      "Edit(//Users/dima/.dotfiles/.clauderc/**)",
      "Bash",
      "mcp__next-devtools",
      "mcp__grep-mcp",
      "mcp__plugin_Notion_notion",
      "mcp__plugin_linear_linear",
      "mcp__plugin_vercel_vercel",
      "mcp__plugin_context7_context7"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/notification.sh"
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "/Users/dima/.claude/sline/bin",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "mattpocock-skills@claude-plugins-official": true,
    "x@x": true,
    "ralph-loop@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "ui-theme-designer@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      },
      "autoUpdate": true
    },
    "x": {
      "source": {
        "source": "directory",
        "path": "/Users/dima/.dotfiles/.clauderc/plugin-x"
      },
      "autoUpdate": true
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "low",
  "fastMode": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "theme": "custom:gruvbox-ansi",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
